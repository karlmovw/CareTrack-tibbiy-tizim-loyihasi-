('J06.9', &quot;O'tkir respirator infeksiya (ARVI)&quot;, 'Yuqori nafas yo''llari virusli infeksiyasi',        'Yengil',   '2026-05-01', (SELECT id FROM patients WHERE lastName='Aliyev'    LIMIT 1)),
('I10',   'Arterial gipertenziya',              'Qon bosimining surunkali ko''tarilishi',             'O''rtacha', '2026-04-28', (SELECT id FROM patients WHERE lastName='Nazarova'  LIMIT 1)),
('K29.7', 'Surunkali gastrit',                  'Oshqozon shilliq qavatining yallig''lanishi',        'O''rtacha', '2026-05-03', (SELECT id FROM patients WHERE lastName='Rahimov'   LIMIT 1)),
('I21.0', 'O''tkir miokard infarkti',           'Yurak mushagi o''tkir ishemiyasi',                   'Og''ir',    '2026-05-10', (SELECT id FROM patients WHERE lastName='Mirzayeva' LIMIT 1)),
('E11',   '2-tip qandli diabet',                'Insulinga rezistentlik bilan kechuvchi diabet',      'O''rtacha', '2026-04-15', (SELECT id FROM patients WHERE lastName='Xasanov'   LIMIT 1)),
('M54.5', 'Bel sohasidagi og''riq',             'Umurtqa pog''onasi pastki qismidagi og''riq',        'Yengil',   '2026-05-07', (SELECT id FROM patients WHERE lastName='Toxirova'  LIMIT 1)),
('J45',   'Bronxial astma',                     'Surunkali nafas yo''llari kasalligi',                'Og''ir',    '2026-05-05', (SELECT id FROM patients WHERE lastName='Qodirov'   LIMIT 1)),
('N39.0', 'Siydik yo''llari infeksiyasi',       'Bakterial siydik yo''llari infeksiyasi',             'O''rtacha', '2026-05-09', (SELECT id FROM patients WHERE lastName='Usmonova'  LIMIT 1)),
('K35.8', 'O''tkir appenditsit',                'Chuvalchang o''simta yallig''lanishi',               'Og''ir',    '2026-05-11', (SELECT id FROM patients WHERE lastName='Yo''ldoshev' LIMIT 1)),
('J02.9', 'O''tkir faringit',                   'Halqum shilliq qavati yallig''lanishi',              'Yengil',   '2026-05-12', (SELECT id FROM patients WHERE lastName='Sobirova'  LIMIT 1));</sql><current_tab id="0"/></tab_sql></sqlb_project>
